{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "description": "The full-featured Marko starter app with TypeScript, testing, and Storybook",
  "type": "module",
  "scripts": {
    "@ci:build": "npm run build",
    "@ci:lint": "npm run lint",
    "@ci:test": "CI=true vitest --no-color",
    "build": "marko-run build",
    "dev": "marko-run",
    "format": "eslint --format unix --fix .; prettier . --write --log-level=warn",
    "lint": "mtc && eslint --format unix . && prettier . --check --log-level=warn",
    "prepare": "husky",
    "preview": "marko-run preview",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "storybook": "storybook dev",
    "test": "vitest"
  },
  "dependencies": {
    "marko": "^6.2.2"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@marko/compiler": "^5.40.0",
    "@marko/run": "^0.11.4",
    "@marko/testing-library": "^6.4.1",
    "@marko/type-check": "^3.1.1",
    "@marko/vite": "^6.1.0",
    "@storybook/marko": "^10.1.0",
    "@storybook/marko-vite": "^5.0.0",
    "@types/node": "^26.1.0",
    "@vitest/browser": "^4.1.9",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/browser-preview": "^4.1.9",
    "@vitest/coverage-istanbul": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "prettier-plugin-marko": "^4.0.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "storybook": "^10.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
