{
  "name": "runescape-classic",
  "version": "1.0.0",
  "private": true,
  "description": "A RuneScape Classic style browser MMO clone built with Marko 6 and @marko/run",
  "type": "module",
  "scripts": {
    "@ci:build": "npm run build",
    "@ci:lint": "npm run lint",
    "@ci:test": "CI=true vitest --no-color",
    "build": "marko-run build",
    "dev": "marko-run",
    "format": "eslint --format unix --fix .; prettier . --write --log-level=warn",
    "lint": "mtc && eslint --format unix . && prettier . --check --log-level=warn",
    "prepare": "husky",
    "preview": "marko-run preview",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "storybook": "storybook dev",
    "test": "vitest"
  },
  "dependencies": {
    "marko": "^6.3.42"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@marko/compiler": "^5.42.1",
    "@marko/run": "^0.11.12",
    "@marko/testing-library": "^6.4.2",
    "@marko/type-check": "^3.2.0",
    "@marko/vite": "^6.1.11",
    "@storybook/marko": "^10.1.0",
    "@storybook/marko-vite": "^5.0.0",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/browser-preview": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-marko": "^4.1.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "storybook": "^10.5.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
