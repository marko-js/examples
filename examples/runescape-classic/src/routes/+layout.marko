<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon.png">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content"
    >
    <meta name="theme-color" content="#06121e">
    <meta name="mobile-web-app-capable" content="yes">
    <meta
      name="description"
      content="A RuneScape Classic style browser MMO built with Marko 6 and @marko/run."
    >
    <title>${$global.meta?.pageTitle || "RuneScape Classic"}</title>
  </head>
  <body>
    <${input.content}/>
  </body>
</html>

<style>
  :root {
    --rs-wood: #2f2519;
    --rs-border: #191309;
    --rs-panel: #3b3226;
    --rs-slot: #4a3f2f;
    --rs-slot-hover: #5b4e3a;
    --rs-slot-border: #241c11;
    --rs-text: #e8e0c8;
    --rs-text-dim: #a89e84;
    --rs-gold: #ffd42a;

    color-scheme: dark;
  }

  html,
  body {
    height: 100%;
    overflow: hidden;
    /* The game owns the viewport; nothing on the page scrolls or bounces. */
    overscroll-behavior: none;
  }

  body {
    margin: 0;
    background: #06121e;
    color: var(--rs-text);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    line-height: 1.4;
    -webkit-text-size-adjust: 100%;
  }

  button {
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
  }
</style>
