<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon.png">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content"
    >
    <meta name="theme-color" content="#06121e">
    <meta name="mobile-web-app-capable" content="yes">
    <meta
      name="description"
      content="A RuneScape Classic style browser MMO built with Marko 6 and @marko/run."
    >
    <title>${$global.meta?.pageTitle || "RuneScape Classic"}</title>
  </head>
  <body>
    <${input.content}/>
  </body>
</html>

<style>
  /*
   * The RuneScape 2 interface: carved olive stone around the game, a dark
   * brown backing behind the panels, and parchment under the chat.
   */
  :root {
    --rs-wood: #2f2519;
    --rs-border: #0d0b07;
    --rs-panel: #4a4033;
    --rs-slot: #574b3b;
    --rs-slot-hover: #6a5c48;
    --rs-slot-border: #2a2419;
    --rs-text: #e8e0c8;
    --rs-text-dim: #a89e84;
    --rs-gold: #ffd42a;
    --rs-ink: #16130c;

    /* Mottled stone and parchment, mixed from gradients: the game ships no images. */
    --rs-stone:
      repeating-linear-gradient(
        37deg,
        rgba(255, 255, 255, 0.05) 0 1px,
        transparent 1px 3px
      ),
      repeating-linear-gradient(
        -53deg,
        rgba(0, 0, 0, 0.07) 0 1px,
        transparent 1px 4px
      ),
      repeating-linear-gradient(
        88deg,
        rgba(0, 0, 0, 0.05) 0 2px,
        transparent 2px 9px
      ),
      linear-gradient(#544c39, #3a3427);

    --rs-parchment:
      repeating-linear-gradient(
        63deg,
        rgba(0, 0, 0, 0.03) 0 1px,
        transparent 1px 4px
      ),
      repeating-linear-gradient(
        -41deg,
        rgba(255, 255, 255, 0.14) 0 1px,
        transparent 1px 5px
      ),
      linear-gradient(#cfc29e, #bcae88);

    color-scheme: dark;
  }

  html,
  body {
    height: 100%;
    overflow: hidden;
    /* The game owns the viewport; nothing on the page scrolls or bounces. */
    overscroll-behavior: none;
  }

  body {
    margin: 0;
    background: #06121e;
    color: var(--rs-text);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    line-height: 1.4;
    -webkit-text-size-adjust: 100%;
  }

  button {
    font-family: inherit;
    -webkit-tap-highlight-color: transparent;
  }
</style>
