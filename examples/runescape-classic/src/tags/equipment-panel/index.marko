import type { Bonus, EquipSlot } from "../../game/items";
import type { UiEquipSlot } from "../../game/ui";
import styles from "./styles.module.css";

/** The client hangs the worn gear on a figure; empty cells are the gaps. */
static const LAYOUT: (EquipSlot | null)[] = [
  null,
  "helmet",
  null,
  "cape",
  "amulet",
  "ammo",
  "weapon",
  "body",
  "shield",
  null,
  "legs",
  null,
];

export interface Input {
  slots: UiEquipSlot[];
  bonus: Bonus;
  maxHit: number;
  onRemove: (slot: EquipSlot) => void;
}

<div class=styles.doll>
  <for|slot| of=LAYOUT by=(slot) => slot ?? "gap">
    <if=slot>
      <const/entry=input.slots.find((found) => found.slot === slot)>
      <div class=styles.cell>
        <if=entry>
          <item-slot
            item=entry.item
            title=(
              entry.item ? `${entry.item.name} — click to remove` : entry.name
            )
            onSelect() {
              if (entry.item) input.onRemove(entry.slot);
            }
          />
        </if>
      </div>
    </if>
    <else>
      <div/>
    </else>
  </for>
</div>

<dl class=styles.stats>
  <div>
    <dt>Weapon aim</dt>
    <dd>+${input.bonus.aim}</dd>
  </div>
  <div>
    <dt>Weapon power</dt>
    <dd>+${input.bonus.power}</dd>
  </div>
  <div>
    <dt>Armour</dt>
    <dd>+${input.bonus.armour}</dd>
  </div>
  <div>
    <dt>Magic</dt>
    <dd>+${input.bonus.magic}</dd>
  </div>
  <div>
    <dt>Prayer</dt>
    <dd>+${input.bonus.prayer}</dd>
  </div>
  <div class=styles.highlight>
    <dt>Max hit</dt>
    <dd>${input.maxHit}</dd>
  </div>
</dl>
