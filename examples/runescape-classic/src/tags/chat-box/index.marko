import type { ChatMessage } from "../../game/state";
import styles from "./styles.module.css";

export interface Input {
  messages: ChatMessage[];
  /** Collapsed shows the last few lines and lets taps reach the game. */
  open: boolean;
  onSay: (text: string) => void;
}

/** The strip under the chat, filtering the log the way the client's does. */
static const FILTERS: {
  id: string;
  name: string;
  tones: ChatMessage["tone"][] | null;
}[] = [
  { id: "all", name: "All", tones: null },
  { id: "game", name: "Game", tones: ["game", "skill", "quest", "combat"] },
  { id: "public", name: "Public", tones: ["chat"] },
];

<let/draft="">
<let/filter="all">

<const/tones=FILTERS.find((entry) => entry.id === filter)?.tones ?? null>

<const/kept=(
  tones
    ? input.messages.filter((message) => tones.includes(message.tone))
    : input.messages
)>

<const/visible=input.open ? kept : kept.slice(-4)>

<div class=[styles.chat, input.open && styles.open]>
  <ol/log class=styles.log>
    <for|message| of=visible by="id">
      <li class=[
        styles.line,
        styles[message.tone === "chat" ? "chatTone" : message.tone],
      ]>
        ${message.text}
      </li>
    </for>
  </ol>

  <show=input.open>
    <form
      class=styles.form
      onSubmit(event) {
        event.preventDefault();
        input.onSay(draft);
        draft = "";
      }
    >
      <label class=styles.label for="chat-input">Say</label>
      <input
        id="chat-input"
        class=styles.input
        autocomplete="off"
        placeholder="Say something…"
        value:=draft
      >
    </form>
  </show>

  <div class=styles.tabs>
    <for|entry| of=FILTERS by="id">
      <button
        type="button"
        class=[styles.tab, filter === entry.id && styles.tabOn]
        aria-pressed=filter === entry.id && "true"
        onClick() {
          filter = entry.id;
        }
      >
        ${entry.name}
      </button>
    </for>
  </div>
</div>

<script>
  // Keep the newest message in view as the log grows.
  void input.messages.length;
  void input.open;
  void filter;
  log().scrollTop = log().scrollHeight;
</script>
