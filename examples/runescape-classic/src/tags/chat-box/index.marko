import type { ChatMessage } from "../../game/state";
import styles from "./styles.module.css";

export interface Input {
  messages: ChatMessage[];
  onSay: (text: string) => void;
}

<let/draft="">

<div class=styles.chat>
  <ol/log class=styles.log>
    <for|message| of=input.messages by="id">
      <li class=[styles.line, styles[message.tone]]>${message.text}</li>
    </for>
  </ol>

  <form
    class=styles.form
    onSubmit(event) {
      event.preventDefault();
      input.onSay(draft);
      draft = "";
    }
  >
    <label class=styles.label for="chat-input">Say</label>
    <input
      id="chat-input"
      class=styles.input
      autocomplete="off"
      placeholder="Type a message and press enter"
      value:=draft
    >
  </form>
</div>

<script>
  // Keep the newest message in view as the log grows.
  void input.messages.length;
  log().scrollTop = log().scrollHeight;
</script>
