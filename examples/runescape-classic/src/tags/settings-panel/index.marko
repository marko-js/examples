import { COMBAT_STYLES, type CombatStyle } from "../../game/state";
import styles from "./styles.module.css";

export interface Input {
  name: string;
  combatStyle: CombatStyle;
  onName: (name: string) => void;
  onCombatStyle: (style: CombatStyle) => void;
  onReset: () => void;
}

<let/draft=input.name>

<section class=styles.section>
  <h3 class=styles.heading>Display name</h3>
  <input
    class=styles.name
    aria-label="Display name"
    maxlength=12
    value:=draft
    onChange() {
      input.onName(draft);
    }
  >
</section>

<section class=styles.section>
  <h3 class=styles.heading>Combat style</h3>
  <for|style| of=COMBAT_STYLES by="id">
    <label class=[
      styles.option,
      input.combatStyle === style.id && styles.active,
    ]>
      <input
        type="radio"
        name="combat-style"
        value=style.id
        checkedValue=input.combatStyle
        onChange() {
          input.onCombatStyle(style.id);
        }
      >
      <span><strong>${style.name}</strong><small>${style.blurb}</small></span>
    </label>
  </for>
</section>

<section class=styles.section>
  <h3 class=styles.heading>Controls</h3>
  <ul class=styles.help>
    <li>Tap or click to walk and to use the first action.</li>
    <li>Long press, or right click, for the full menu.</li>
    <li>Tap an item to wield, eat or bury it.</li>
    <li>Long press an item to use, drop or examine it.</li>
    <li>Tap the minimap to travel further.</li>
    <li>Use a tinderbox on logs to light a fire.</li>
    <li>Use raw fish on a fire to cook it.</li>
  </ul>
</section>

<section class=styles.section>
  <h3 class=styles.heading>Save</h3>
  <p class=styles.note>
    Progress is stored in this browser and saved every 15 seconds.
  </p>
  <button
    type="button"
    class=styles.danger
    onClick() {
      input.onReset();
    }
  >
    Delete save and restart
  </button>
</section>
